# =============================================
# ДАННЫЕ ПРИЛОЖЕНИЯ
# =============================================
APP_ENV=prod
APP_DEBUG=false
APP_NAME="Task Diary"
APP_URL=https://taskdiary.onrender.com
DEFAULT_URI=https://taskdiary.onrender.com

# =============================================
# БАЗА ДАННЫХ
# =============================================
DATABASE_URL=postgresql://user:password@localhost:5432/taskdiary?serverVersion=16&charset=utf8

# =============================================
# PHP НАСТРОЙКИ
# =============================================
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=300
PHP_TIMEZONE=Europe/Moscow

# =============================================
# СЕКРЕТЫ
# =============================================
APP_SECRET=change_me
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
MERCURE_PUBLISH_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=change_me
GIGACHAT_API_KEY=change_me
