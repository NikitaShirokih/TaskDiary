# =============================================
# ДАННЫЕ ПРИЛОЖЕНИЯ
# =============================================

APP_ENV=dev
APP_DEBUG=true
APP_NAME="Task Diary"
APP_URL=http://localhost:8082
DEFAULT_URI=http://localhost:8082

# =============================================
# БАЗА ДАННЫХ POSTGRESQL
# =============================================

DATABASE_URL=postgresql://user:password@postgres:5432/taskdiary?serverVersion=15&charset=utf8

DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskdiary
DB_USER=user
DB_PASSWORD=password

# =============================================
# PHP НАСТРОЙКИ
# =============================================

PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=300
PHP_DISPLAY_ERRORS=On
PHP_ERROR_REPORTING=E_ALL
PHP_TIMEZONE=Europe/Moscow

###> redis ###
REDIS_DSN=redis://redis:6379
###< redis ###

# =============================================
# DOCKER КОНТЕЙНЕРЫ
# =============================================

NGINX_HTTP_PORT=8082
NGINX_HTTPS_PORT=443
POSTGRES_PORT=5432

# =============================================
# ПУТИ
# =============================================

PROJECT_ROOT=..
NGINX_CONF_PATH=./.docker/nginx/default.conf

# =============================================
# СЕКРЕТНЫЙ КЛЮЧ
# =============================================

APP_SECRET=changeme

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MERCURE_PUBLISH_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=changeme

GIGACHAT_API_KEY=changeme
