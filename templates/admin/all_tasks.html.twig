{% extends 'base.html.twig' %}

{% block title %}Все задачи | Админка{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Все задачи</h1>
            <p class="text-muted mb-0">Список задач всех пользователей</p>
        </div>

        <a href="{{ path('admin_panel') }}" class="btn btn-outline-primary rounded-3">
            Назад в админку
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            {% if tasks is not empty %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">id</th>
                            <th class="px-4 py-3">Название задачи</th>
                            <th class="px-4 py-3">Пользователь</th>
                            <th class="px-4 py-3">Статус</th>
                            <th class="px-4 py-3">Действия</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for task in tasks %}
                            <tr>
                                <td class="px-4 py-3 text-muted">
                                    {{ task.id }}
                                </td>
                                <td class="px-4 py-3 fw-medium">
                                    {{ task.title }}
                                </td>
                                <td class="px-4 py-3">
                                    {% if task.user is defined and task.user %}
                                        <div class="d-flex flex-column">
                                            <span>{{ task.user.email }}</span>
                                        </div>
                                    {% else %}
                                        <span class="text-muted">Не назначен</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    {% if task.isCompleted is defined %}
                                        {% if task.isCompleted %}
                                            <span class="badge bg-success">Выполнена</span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark">В процессе</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="badge bg-secondary">Без статуса</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    <div class="d-flex flex-wrap gap-2">
                                        {% if task.id %}
                                            <a href="{{ path('task_show', {'id': task.id}) }}"
                                               class="btn btn-sm btn-outline-primary rounded-3">
                                                Открыть
                                            </a>

                                            <a href="{{ path('task_edit', {'id': task.id}) }}"
                                               class="btn btn-sm btn-outline-secondary rounded-3">
                                                Редактировать
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="p-4">
                    <div class="alert alert-info mb-0 rounded-3">
                        Задач пока нет.
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
