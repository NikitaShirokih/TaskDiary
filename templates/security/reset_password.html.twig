{% extends 'base.html.twig' %}

{% block title %}Новый пароль{% endblock %}

{% block navbar %}
    <nav class="navbar navbar-dark bg-primary shadow-sm">
        <div class="container justify-content-center">
            <a class="navbar-brand fw-bold fs-4" href="#">
                📘 Task Diary
            </a>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="text-center fw-bold mb-1">Новый пароль</h4>
                    <p class="text-center text-muted mb-4" style="font-size: 14px;">
                        Введите новый пароль для аккаунта
                    </p>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="mb-3">
                        {{ form_label(form.plainPassword.first, 'Новый пароль', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.plainPassword.second, 'Повторите пароль', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>

                    {{ form_errors(form.plainPassword) }}
                    {{ form_errors(form) }}

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3">
                            Сохранить пароль
                        </button>
                    </div>

                    {{ form_end(form) }}

                    <p class="text-center text-muted mt-3 mb-0" style="font-size: 14px;">
                        <a href="{{ path('app_login') }}" class="text-primary fw-semibold text-decoration-none">Вернуться ко входу</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
