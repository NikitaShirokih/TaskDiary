{% extends 'base.html.twig' %}

{% block title %}Task Diary - Главная{% endblock %}

{% block body %}
    <div class="container-fluid py-3 px-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="mb-0 fs-4 fw-bold">📘 Task Diary</h1>
                <p class="text-muted small mb-0">Обзор задач и календарь</p>
            </div>

            <a href="{{ path('task_new') }}" class="btn btn-primary btn-sm">+ Новая задача</a>
        </div>

        <div class="row g-3">

            <div class="col-lg-3 d-flex flex-column gap-3">

                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <h6 class="text-muted mb-3">Активность</h6>

                        <div class="d-flex align-items-center justify-content-between mb-3 p-2 rounded" style="background-color: #e8f4fd;">
                            <div>
                                <div class="small text-muted">Активных задач</div>
                                <div class="fw-bold fs-4 text-primary">{{ stats.activeTasks }}</div>
                            </div>
                            <span style="font-size: 1.8rem;">📋</span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-2 p-2 rounded" style="background-color: #fff8e1;">
                            <div>
                                <div class="small text-muted">Срок истекает сегодня</div>
                                <div class="fw-bold fs-5 text-warning">{{ stats.dueTodayTasks }}</div>
                            </div>
                            <span style="font-size: 1.5rem;">⚠️</span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background-color: #fce8e8;">
                            <div>
                                <div class="small text-muted">Срок истекает за неделю</div>
                                <div class="fw-bold fs-5 text-danger">{{ stats.dueThisWeekTasks }}</div>
                            </div>
                            <span style="font-size: 1.5rem;">🗓️</span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <h6 class="text-muted mb-3">По категориям</h6>
                        <canvas id="categoryChart" style="max-height: 180px;"></canvas>
                    </div>
                </div>

                <div class="card shadow-sm border-0 flex-grow-1">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-muted mb-0">Последние задачи</h6>
                            <a href="{{ path('task_list') }}" class="small text-primary text-decoration-none">Все →</a>
                        </div>

                        {% if latestTasks is not empty %}
                            {% for task in latestTasks %}
                                <div class="mb-2 pb-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <a
                                            href="{{ path('task_show', {id: task.id}) }}"
                                            class="small fw-semibold text-decoration-none text-dark text-break"
                                        >
                                            {{ task.title }}
                                        </a>

                                        {% if task.status.value == 'completed' %}
                                            <span class="badge bg-success ms-1" style="font-size: 0.65rem;">✓</span>
                                        {% elseif task.status.value == 'in_progress' %}
                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">●</span>
                                        {% else %}
                                            <span class="badge bg-secondary ms-1" style="font-size: 0.65rem;">○</span>
                                        {% endif %}
                                    </div>

                                    {% if task.category %}
                                        <span
                                            class="badge rounded-pill mt-1"
                                            style="background-color: {{ task.category.color ?? '#3498db' }}; font-size: 0.65rem;"
                                        >
                                            {{ task.category.name }}
                                        </span>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        {% else %}
                            <p class="text-muted small mb-0">Пока задач нет.</p>
                        {% endif %}
                    </div>
                </div>

            </div>

            <div class="col-lg-9">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-3">
                        <div id="taskCalendar"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

    <style>
        #taskCalendar {
            min-height: calc(100vh - 140px);
        }

        .fc .fc-toolbar-title {
            font-size: 1.1rem;
            font-weight: 600;
        }

        .fc .fc-button {
            background-color: #0d6efd;
            border-color: #0d6efd;
            box-shadow: none !important;
            font-size: 0.8rem;
            padding: 4px 10px;
        }

        .fc .fc-button:hover,
        .fc .fc-button:focus {
            background-color: #0b5ed7;
            border-color: #0b5ed7;
        }

        .fc .fc-daygrid-event,
        .fc .fc-timegrid-event {
            border-radius: 6px;
            padding: 2px 4px;
            font-size: 0.75rem;
        }

        .fc .fc-col-header-cell {
            background-color: #f8f9fa;
            font-size: 0.8rem;
        }
    </style>

    <script>
        const categoryLabels = {{ categoryChart.labels|json_encode|raw }};
        const categoryData   = {{ categoryChart.data|json_encode|raw }};
        const categoryColors = {{ categoryChart.colors|json_encode|raw }};
        const calendarEvents = {{ calendarEvents|default([])|json_encode|raw }};

        const categoryChartElement = document.getElementById('categoryChart');

        if (categoryChartElement) {
            new Chart(categoryChartElement, {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryData,
                        backgroundColor: categoryColors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { size: 11 },
                                boxWidth: 12
                            }
                        }
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const calendarElement = document.getElementById('taskCalendar');

            if (!calendarElement) {
                return;
            }

            const showTaskUrlTemplate = '{{ path('task_show', {id: 0}) }}';

            const calendar = new FullCalendar.Calendar(calendarElement, {
                initialView: 'dayGridMonth',
                locale: 'ru',
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                buttonText: {
                    today: 'Сегодня',
                    month: 'Месяц',
                    week: 'Неделя',
                    day: 'День'
                },
                events: calendarEvents,
                eventClick: function (info) {
                    if (info.event.id) {
                        window.location.href = showTaskUrlTemplate.replace('/0', '/' + info.event.id);
                    }
                }
            });

            calendar.render();
        });
    </script>
{% endblock %}
