{% extends 'base.html.twig' %}

{% block title %}Регистрация{% endblock %}

{% block navbar %}
    <nav class="navbar navbar-dark bg-primary shadow-sm">
        <div class="container justify-content-center">
            <a class="navbar-brand fw-bold fs-4" href="#">
                📘 Task Diary
            </a>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <h4 class="text-center fw-bold mb-1">Создать аккаунт</h4>
                    <p class="text-center text-muted mb-4" style="font-size: 14px;">
                        Заполните форму чтобы зарегистрироваться
                    </p>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="mb-3">
                        {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'example@mail.com'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.plainPassword.password, 'Пароль', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.plainPassword.password, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                        {{ form_errors(form.plainPassword.password) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.plainPassword.confirm_password, 'Повторите пароль', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.plainPassword.confirm_password, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                        {{ form_errors(form.plainPassword.confirm_password) }}
                    </div>

                    {{ form_errors(form) }}

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3">
                            Зарегистрироваться
                        </button>
                    </div>

                    {{ form_end(form) }}

                    <p class="text-center text-muted mt-3 mb-0" style="font-size: 14px;">
                        Уже есть аккаунт? <a href="{{ path('app_login') }}" class="text-primary fw-semibold text-decoration-none">Войти</a>
                    </p>

                </div>
            </div>
        </div>
    </div>
{% endblock %}
