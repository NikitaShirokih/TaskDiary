{% extends 'base.html.twig' %}

{% block title %}Task Diary - Редактирование задачи{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-1">✏️ Редактирование задачи</h1>
                <p class="text-muted mb-0">Обновите информацию о задаче</p>
            </div>

            <div class="d-flex gap-2">
                <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">На главную</a>
                <a href="{{ path('task_list') }}" class="btn btn-outline-primary">К списку задач</a>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% set titleValue = taskData ? taskData.title : task.title %}
        {% set descriptionValue = taskData ? taskData.description : task.description %}
        {% set priorityValue = taskData ? taskData.priority : task.priority.value %}
        {% set statusValue = taskData ? taskData.status : task.status.value %}
        {% set startTimeValue = taskData and taskData.startTime ? taskData.startTime : task.startTime %}
        {% set endTimeValue = taskData and taskData.endTime ? taskData.endTime : task.endTime %}
        {% set categoryValue = taskData ? taskData.categoryId : (task.category ? task.category.id : null) %}

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="mb-4">Данные задачи</h4>

                <form method="post" action="{{ path('task_edit', {id: task.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('task_edit') }}">

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="title" class="form-label fw-semibold">Название задачи</label>
                            <input
                                id="title"
                                type="text"
                                name="title"
                                class="form-control"
                                value="{{ titleValue }}"
                                required
                            >
                        </div>

                        <div class="col-md-6">
                            <label for="priority" class="form-label fw-semibold">Приоритет</label>
                            <select id="priority" name="priority" class="form-select">
                                <option value="low" {{ priorityValue == 'low' ? 'selected' }}>Низкий</option>
                                <option value="medium" {{ priorityValue == 'medium' ? 'selected' }}>Средний</option>
                                <option value="high" {{ priorityValue == 'high' ? 'selected' }}>Высокий</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="description" class="form-label fw-semibold">Описание</label>
                            <textarea
                                id="description"
                                name="description"
                                rows="4"
                                class="form-control"
                            >{{ descriptionValue }}</textarea>
                        </div>

                        <div class="col-md-6">
                            <label for="start_time" class="form-label fw-semibold">Дата начала</label>
                            <input
                                id="start_time"
                                type="datetime-local"
                                name="start_time"
                                class="form-control"
                                value="{{ startTimeValue ? startTimeValue|date('Y-m-d\\TH:i') : '' }}"
                            >
                        </div>

                        <div class="col-md-6">
                            <label for="end_time" class="form-label fw-semibold">Дата окончания</label>
                            <input
                                id="end_time"
                                type="datetime-local"
                                name="end_time"
                                class="form-control"
                                value="{{ endTimeValue ? endTimeValue|date('Y-m-d\\TH:i') : '' }}"
                            >
                        </div>

                        <div class="col-md-6">
                            <label for="status" class="form-label fw-semibold">Статус</label>
                            <select id="status" name="status" class="form-select">
                                <option value="waiting" {{ statusValue == 'waiting' ? 'selected' }}>Ожидание</option>
                                <option value="in_progress" {{ statusValue == 'in_progress' ? 'selected' }}>В работе</option>
                                <option value="completed" {{ statusValue == 'completed' ? 'selected' }}>Завершено</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="category" class="form-label fw-semibold">Категория</label>
                            <select id="category" name="category" class="form-select" required>
                                <option value="" disabled {{ categoryValue is empty ? 'selected' }}>
                                    — Выберите категорию —
                                </option>
                                {% for category in categories %}
                                    <option value="{{ category.id }}" {{ categoryValue == category.id ? 'selected' }}>
                                        {{ category.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                        <a href="{{ path('task_show', {id: task.id}) }}" class="btn btn-light border">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
