{% extends 'base.html.twig' %}

{% block title %}Task Diary - Редактирование задачи{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-1">✏️ Редактирование задачи</h1>
                <p class="text-muted mb-0">Обновите информацию о задаче</p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">На главную</a>
                <a href="{{ path('task_list') }}" class="btn btn-outline-primary">К списку задач</a>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="mb-4">Данные задачи</h4>

                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('task_edit') }}">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Название задачи</label>
                            <input type="text" name="title" class="form-control" value="{{ task.title }}" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Приоритет</label>
                            {% set priorityValue = task.priority.value %}
                            <select name="priority" class="form-select">
                                <option value="low" {% if priorityValue == 'low' %}selected{% endif %}>Низкий</option>
                                <option value="medium" {% if priorityValue == 'medium' %}selected{% endif %}>Средний</option>
                                <option value="high" {% if priorityValue == 'high' %}selected{% endif %}>Высокий</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Описание</label>
                            <textarea name="description" rows="4" class="form-control">{{ task.description }}</textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Дата начала</label>
                            <input type="datetime-local" name="start_time" class="form-control"
                                   value="{{ task.startTime ? task.startTime|date('Y-m-d\\TH:i') : '' }}">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Дата окончания</label>
                            <input type="datetime-local" name="end_time" class="form-control"
                                   value="{{ task.endTime ? task.endTime|date('Y-m-d\\TH:i') : '' }}">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Статус</label>
                            {% set statusValue = task.status.value %}
                            <select name="status" class="form-select">
                                <option value="waiting" {% if statusValue == 'waiting' %}selected{% endif %}>Ожидание</option>
                                <option value="in_progress" {% if statusValue == 'in_progress' %}selected{% endif %}>В работе</option>
                                <option value="completed" {% if statusValue == 'completed' %}selected{% endif %}>Завершено</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Категория</label>
                            <select name="category" class="form-select" required>
                                <option value="" disabled {% if not task.category %}selected{% endif %}>— Выберите категорию —</option>
                                {% for category in categories %}
                                    <option value="{{ category.id }}"
                                            {% if task.category and task.category.id == category.id %}selected{% endif %}>
                                        {{ category.name }}
                                    </option>
                                {% endfor %}
                            </select>

                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                        <a href="{{ path('task_list') }}" class="btn btn-light border">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
