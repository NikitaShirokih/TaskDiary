{% extends 'base.html.twig' %}

{% block title %}Task Diary - Список задач{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="mb-1">📋 Список задач</h1>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path('task_new') }}" class="btn btn-primary">+ Новая задача</a>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success shadow-sm">✅ {{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger shadow-sm">❌ {{ message }}</div>
        {% endfor %}

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h4 class="mb-3">Фильтры</h4>

                <form method="get" action="{{ path('task_list') }}">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Категория</label>
                            <select name="category" class="form-select">
                                <option value="">Все категории</option>
                                {% if categories is defined %}
                                    {% for category in categories %}
                                        <option value="{{ category.id }}" {{ app.request.get('category') == category.id ? 'selected' }}>
                                            {{ category.name }}
                                        </option>
                                    {% endfor %}
                                {% endif %}
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Приоритет</label>
                            <select name="priority" class="form-select">
                                <option value="">Все приоритеты</option>
                                <option value="high" {{ app.request.get('priority') == 'high' ? 'selected' }}>Высокий</option>
                                <option value="medium" {{ app.request.get('priority') == 'medium' ? 'selected' }}>Средний</option>
                                <option value="low" {{ app.request.get('priority') == 'low' ? 'selected' }}>Низкий</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Статус</label>
                            <select name="status" class="form-select" id="status-filter">
                                <option value="">Все активные статусы</option>
                                <option value="waiting" {{ app.request.get('status') == 'waiting' ? 'selected' }}>Ожидание</option>
                                <option value="in_progress" {{ app.request.get('status') == 'in_progress' ? 'selected' }}>В работе</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary w-100">Фильтровать</button>
                                <a href="{{ path('task_list') }}" class="btn btn-light border">Сброс</a>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-primary view-switch-link active" data-view="active">
                            Активные
                        </button>
                        <button type="button" class="btn btn-outline-success view-switch-link" data-view="completed">
                            Завершённые
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div id="tasks-content" class="tasks-content">
                    {% include 'task/_tasks_table.html.twig' with { tasks: tasks } %}
                </div>
            </div>
        </div>
    </div>

    <style>
        .tasks-content.loading {
            opacity: 0.6;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        .priority-badge {
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }

        .priority-high {
            background: #ffe6e6;
            color: #dc3545;
        }

        .priority-medium {
            background: #fff3cd;
            color: #856404;
        }

        .priority-low {
            background: #e6f3e6;
            color: #155724;
        }

        .table td,
        .table th {
            word-break: break-word;
            white-space: normal;
        }

        .table td:nth-child(4) {
            max-width: 220px;
        }

        .table td:nth-child(3) {
            max-width: 180px;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tasksContent = document.getElementById('tasks-content');
            const switchButtons = document.querySelectorAll('.view-switch-link');
            const statusSelect = document.getElementById('status-filter');
            let currentView = new URLSearchParams(window.location.search).get('view') || 'active';

            function applyActiveButton(view) {
                switchButtons.forEach(btn => {
                    btn.classList.remove('active', 'btn-primary', 'btn-success', 'btn-outline-primary', 'btn-outline-success');

                    if (btn.dataset.view === view) {
                        btn.classList.add('active', view === 'active' ? 'btn-primary' : 'btn-success');
                    } else {
                        btn.classList.add(btn.dataset.view === 'active' ? 'btn-outline-primary' : 'btn-outline-success');
                    }
                });
            }

            function applyStatusOptions(view) {
                if (!statusSelect) {
                    return;
                }

                if (view === 'completed') {
                    statusSelect.innerHTML = '<option value="">Все завершённые</option><option value="completed">Завершено</option>';
                } else {
                    statusSelect.innerHTML = '<option value="">Все активные статусы</option><option value="waiting">Ожидание</option><option value="in_progress">В работе</option>';
                }
            }

            applyActiveButton(currentView);
            applyStatusOptions(currentView);

            switchButtons.forEach(button => {
                button.addEventListener('click', async function () {
                    const selectedView = this.dataset.view;

                    if (selectedView === currentView) {
                        return;
                    }

                    currentView = selectedView;
                    applyActiveButton(selectedView);
                    applyStatusOptions(selectedView);

                    if (statusSelect) {
                        statusSelect.value = '';
                    }

                    tasksContent.classList.add('loading');

                    const params = new URLSearchParams(window.location.search);
                    params.set('view', selectedView);
                    params.delete('status');

                    try {
                        const response = await fetch(`{{ path('task_ajax_list') }}?${params.toString()}`, {
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!response.ok) {
                            throw new Error('Не удалось загрузить список задач.');
                        }

                        tasksContent.innerHTML = await response.text();

                        const newUrl = `${window.location.pathname}?${params.toString()}`;
                        window.history.replaceState({}, '', newUrl);
                    } catch (error) {
                        tasksContent.innerHTML = `
                            <div class="p-4">
                                <div class="alert alert-danger mb-0">
                                    ❌ ${error.message}
                                </div>
                            </div>
                        `;
                    } finally {
                        tasksContent.classList.remove('loading');
                    }
                });
            });
        });
    </script>
{% endblock %}
