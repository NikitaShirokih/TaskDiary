# =============================================
# ДАННЫЕ ПРИЛОЖЕНИЯ
# =============================================

APP_ENV=dev
APP_DEBUG=true
APP_NAME="Task Diary"
APP_URL=http://localhost:8082
DEFAULT_URI=http://localhost:8082

# =============================================
# БАЗА ДАННЫХ MYSQL
# =============================================

DATABASE_URL=mysql://user:password@mysql:3306/taskdiary?serverVersion=8.0&charset=utf8mb4
DB_HOST=mysql
DB_PORT=3306
DB_NAME=taskdiary
DB_USER=user
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootpassword

# =============================================
# PHP НАСТРОЙКИ
# =============================================

PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=300
PHP_DISPLAY_ERRORS=On
PHP_ERROR_REPORTING=E_ALL
PHP_TIMEZONE=Europe/Moscow

# =============================================
# DOCKER КОНТЕЙНЕРЫ
# =============================================

NGINX_HTTP_PORT=8082
NGINX_HTTPS_PORT=443
PHPMYADMIN_PORT=8081

# =============================================
# ПУТИ
# =============================================

PROJECT_ROOT=..
NGINX_CONF_PATH=./.docker/nginx/default.conf
PHP_DOCKERFILE_PATH=.docker/php-fpm/Dockerfile
PHP_INI_PATH=./.docker/php-fpm/php.ini
PHP_FPM_CONF_PATH=./.docker/php-fpm/php-fpm.conf
MYSQL_DATA_VOLUME=mysql_data

# =============================================
# СЕКРЕТНЫЙ КЛЮЧ
# =============================================

APP_SECRET=changeme

GIGACHAT_API_KEY=changeme

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MERCURE_PUBLISH_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=changeme
